DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://vimple-backend.onrender.com
TASKS_API_TOKEN=change-me
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
MELI_CLIENT_ID=change-me
MELI_CLIENT_SECRET=change-me
# Argentina. Change this if the DevCenter app is for another country.
MELI_AUTH_URL=https://auth.mercadolibre.com.ar/authorization
# Callback URLs to register on the Mercado Libre app:
# http://127.0.0.1:8000/meli/callback/
# https://vimple-backend.onrender.com/meli/callback/
MELI_WEBHOOK_SECRET=change-me
# Upstash Redis (rediss://...). Empty runs the post-sale sync inside the request.
REDIS_URL=
# Notifications URL to register on the Mercado Libre app:
# https://vimple-backend.onrender.com/meli/webhooks/<MELI_WEBHOOK_SECRET>/
MIST_API_KEY=change-me
# Google Picker for choosing receipt folders. Empty hides the Choose in Drive buttons.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
# Authorized redirect URIs:
# http://127.0.0.1:8000/accounts/google/login/callback/
# https://vimple-backend.onrender.com/accounts/google/login/callback/